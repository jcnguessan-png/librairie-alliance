# Notion CMS Integration
# 1. Créer une intégration sur https://www.notion.so/my-integrations
# 2. Copier le "Internal Integration Secret"
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Créer une base de données Notion avec les propriétés documentées dans le README
# 4. Partager la base avec votre intégration (Share > Invite)
# 5. Copier l'ID de la base (dans l'URL : notion.so/xxx?v=yyy → xxx est l'ID)
NOTION_BOOKS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin — Mot de passe pour accéder au back-office (/admin)
# IMPORTANT : Changez ce mot de passe en production !
ADMIN_PASSWORD=votre_mot_de_passe_ici
